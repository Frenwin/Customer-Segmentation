table fact_sales
	lineageTag: 34f3e3d2-76f1-507f-9ee0-596c9f5ff344

	measure 'Total Revenue' = SUM('fact_sales'[line_total])
		formatString: "Rp" #,0
		lineageTag: d232f7b8-4074-5650-8cfe-263d60f565d5

	measure 'Total Orders' = DISTINCTCOUNT('fact_sales'[order_key])
		formatString: #,0
		lineageTag: 6e8ef5d6-cb30-50be-aaf9-313082d5f086

	measure 'Total Customers' = DISTINCTCOUNT('fact_sales'[customer_key])
		formatString: #,0
		lineageTag: ad8fd23e-8c1e-5848-87aa-e6fc59e18ff9

	measure 'Items Sold' = SUM('fact_sales'[quantity])
		formatString: #,0
		lineageTag: 499d9ef2-4034-5bfe-b284-9b849fc375f5

	measure 'Average Order Value' = DIVIDE([Total Revenue], [Total Orders])
		formatString: "Rp" #,0
		lineageTag: aa5786ca-624f-5a49-b68f-ef30636c5762

	measure 'Average Revenue per Customer' = DIVIDE([Total Revenue], [Total Customers])
		formatString: "Rp" #,0
		lineageTag: 7fba2c92-f561-5b54-8590-5e82f1f44480

	measure 'Purchase Frequency' = DIVIDE([Total Orders], [Total Customers])
		formatString: 0.000
		lineageTag: 1d7361e4-5b0a-57a7-aa14-7ef0afd4b336

	measure 'Average Basket Size' = DIVIDE([Items Sold], [Total Orders])
		formatString: 0.00
		lineageTag: 37fa8ca3-e5ea-5a33-96b4-0725cd68ad06

	measure 'Revenue Contribution' = DIVIDE([Total Revenue], CALCULATE([Total Revenue], REMOVEFILTERS('dim_customer'[segment_name], 'dim_customer'[segment_id])))
		formatString: 0.0%
		lineageTag: 4d1842b2-154b-5fd8-b196-215642889247

	measure 'Segment Distribution' = DIVIDE([Total Customers], CALCULATE([Total Customers], REMOVEFILTERS('dim_customer'[segment_name], 'dim_customer'[segment_id])))
		formatString: 0.0%
		lineageTag: aa6a24bc-bf38-54c6-9a4f-093a51fc7ef1

	measure 'Revenue Label' = VAR v = [Total Revenue] RETURN SWITCH(TRUE(), ISBLANK(v), "–", v >= 1e12, "Rp " & FORMAT(v / 1e12, "#,0.00") & " triliun", v >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.0") & " miliar", v >= 1e7, "Rp " & FORMAT(v / 1e6, "#,0.0") & " juta", "Rp " & FORMAT(v, "#,0"))
		lineageTag: b1141575-0976-59b8-b892-8b1882a525b6

	measure 'Revenue (Rp miliar)' = DIVIDE([Total Revenue], 1e9)
		formatString: #,0.0
		lineageTag: 210dad48-c254-55fc-a1f3-ca554174501c

	measure 'AOV (Rp ribu)' = DIVIDE([Average Order Value], 1e3)
		formatString: 0
		lineageTag: fcde7cf8-faaa-5737-9583-9f5e73ca3402

	measure 'Avg Spend (Rp ribu)' = DIVIDE([Average Revenue per Customer], 1e3)
		formatString: 0
		lineageTag: a703854f-7759-53eb-9e15-57f867cf2834

	measure 'Top 10 Revenue' = VAR r = RANKX(ALLSELECTED('dim_customer'[customer_code]), [Total Revenue], , DESC) RETURN IF(r <= 10, [Total Revenue])
		formatString: "Rp" #,0
		lineageTag: 9b2bb2f7-8a29-5070-bc01-f0fee4de0855

	measure 'Total Customers (label)' = VAR v = [Total Customers] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))
		lineageTag: 51046631-c4ab-5cb5-a4a6-c075eeb69a71

	measure 'Average Order Value (label)' = VAR v = [Average Order Value] RETURN IF(ISBLANK(v), "–", SWITCH(TRUE(), v >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.0") & " miliar", v >= 1e7, "Rp " & FORMAT(v / 1e6, "#,0.0") & " juta", "Rp " & FORMAT(v, "#,0")))
		lineageTag: bc85a7bd-9945-58f4-a04a-42b52d762b16

	measure 'Segment Distribution (label)' = VAR v = [Segment Distribution] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.0%"))
		lineageTag: 3321260f-4cd3-58b5-b835-e6af5f98ead2

	measure 'Revenue Contribution (label)' = VAR v = [Revenue Contribution] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.0%"))
		lineageTag: 690549f0-a07b-506b-a284-22aedcf63075

	measure 'Average Revenue per Customer (label)' = VAR v = [Average Revenue per Customer] RETURN IF(ISBLANK(v), "–", SWITCH(TRUE(), v >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.0") & " miliar", v >= 1e7, "Rp " & FORMAT(v / 1e6, "#,0.0") & " juta", "Rp " & FORMAT(v, "#,0")))
		lineageTag: 796aa367-3566-5c86-b37d-309ef5896dfc

	measure 'Purchase Frequency (label)' = VAR v = [Purchase Frequency] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.000"))
		lineageTag: 8bd944cc-fb92-550b-86dc-14f3ed886a04

	measure 'Average Basket Size (label)' = VAR v = [Average Basket Size] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.00"))
		lineageTag: cd969e93-df93-5cf3-97e2-9d93d41a1b4d

