table period_retention
	lineageTag: b98e0cd0-8c82-5358-859b-655b462329fe

	measure 'Retention Rate' = DIVIDE(SUM('period_retention'[retained_customers]), SUM('period_retention'[eligible_customers]))
		formatString: 0.00%
		lineageTag: a3b40bfc-7cb7-5539-8228-58e83da0fc6d

	measure 'Churn Rate' = 1 - [Retention Rate]
		formatString: 0.00%
		lineageTag: 0bee0b39-1c32-59d2-b3a1-cbcb15ef2ae4

	measure 'Reactivation Rate' = DIVIDE(SUM('period_retention'[reactivated_customers]), SUM('period_retention'[inactive_customers]))
		formatString: 0.00%
		lineageTag: 879faa97-725a-51e3-8336-855770c55793

	measure 'Reactivated Customers' = SUM('period_retention'[reactivated_customers])
		formatString: #,0
		lineageTag: 7929b643-a784-5050-a9bd-3c70afd8174e

	measure 'Retention Rate (label)' = VAR v = [Retention Rate] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.00%"))
		lineageTag: c9605af1-09f3-5e7a-a113-1167b646575e

	measure 'Churn Rate (label)' = VAR v = [Churn Rate] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.00%"))
		lineageTag: 10f570f6-3e66-5b16-9755-41c5f74b9367

	measure 'Reactivated Customers (label)' = VAR v = [Reactivated Customers] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))
		lineageTag: 301bb6ff-e58b-544a-9ebb-d747a462eca9

