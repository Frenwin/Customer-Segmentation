table dim_customer
	lineageTag: 1935d875-caf2-5b97-ac8b-eec40564da00

	measure 'Customers (Snapshot)' = COUNTROWS('dim_customer')
		formatString: #,0
		lineageTag: 1b6a7159-b18e-5133-b8a5-77af42ba8bf6

	measure 'Active Customers' = CALCULATE(COUNTROWS('dim_customer'), 'dim_customer'[is_churned] = 0)
		formatString: #,0
		lineageTag: c407aca4-b6a9-5b2a-99a1-ef526c11116f

	measure 'Churned Customers' = CALCULATE(COUNTROWS('dim_customer'), 'dim_customer'[is_churned] = 1)
		formatString: #,0
		lineageTag: 0c24ed45-02a8-5651-8394-00ed19a68d5e

	measure 'Churn Rate (Inactivity)' = DIVIDE(COALESCE([Churned Customers], 0), [Customers (Snapshot)])
		formatString: 0.0%
		lineageTag: 38331393-df65-5141-8b5d-085ef922d346

	measure 'Active Customer Rate' = DIVIDE([Active Customers], [Customers (Snapshot)])
		formatString: 0.0%
		lineageTag: e2dad185-24c8-53c1-9474-0ef784f0afa7

	measure 'Repeat Purchase Rate' = DIVIDE(SUM('dim_customer'[is_repeat]), [Customers (Snapshot)])
		formatString: 0.00%
		lineageTag: 9e243bef-46c5-5c60-b7fb-4202c2574c7d

	measure 'Historical CLV' = AVERAGE('dim_customer'[historical_clv])
		formatString: "Rp" #,0
		lineageTag: 90478d40-a77a-5c4e-a0ab-c5d69eee883a

	measure 'Predicted CLV 12m' = AVERAGE('dim_customer'[predicted_clv_12m])
		formatString: "Rp" #,0
		lineageTag: 174d3d52-3198-5f65-a539-87a769cb898c

	measure 'Historical CLV (Rp ribu)' = DIVIDE([Historical CLV], 1e3)
		formatString: 0
		lineageTag: a7fcc8b9-c519-5bda-a136-198837b78f1c

	measure 'Average Recency (days)' = AVERAGE('dim_customer'[recency_days])
		formatString: #,0
		lineageTag: ad26284c-b288-5673-b1d4-c5c4822c217a

	measure 'Average Purchase Interval' = AVERAGE('dim_customer'[avg_purchase_interval_days])
		formatString: #,0 "days"
		lineageTag: b829de7c-bb65-5729-9400-e3f0c28ccc85

	measure 'Segment Color' = SELECTEDVALUE('dim_customer'[segment_color], "#C5CAD6")
		lineageTag: 9f09b77b-a59d-57f4-8221-1a987f2214c1

	measure 'High-Value At-Risk Revenue' = CALCULATE(SUM('dim_customer'[monetary]), 'dim_customer'[is_high_value_at_risk] = 1)
		formatString: "Rp" #,0
		lineageTag: 152f121b-12f6-5268-a0ef-a8d5502cc01f

	measure 'High-Value At-Risk Customers' = CALCULATE(COUNTROWS('dim_customer'), 'dim_customer'[is_high_value_at_risk] = 1)
		formatString: #,0
		lineageTag: 63063179-aef2-55ed-803d-bf14ba037ff0

	measure 'High-Potential CLV' = CALCULATE(SUM('dim_customer'[predicted_clv_12m]), 'dim_customer'[is_high_potential] = 1)
		formatString: "Rp" #,0
		lineageTag: f1f9a3e7-9761-5a12-a3e1-d8a67c19efba

	measure 'High-Potential Customers' = CALCULATE(COUNTROWS('dim_customer'), 'dim_customer'[is_high_potential] = 1)
		formatString: #,0
		lineageTag: c57268dd-06bc-58d2-ba5c-04d3608032d6

	measure 'Active Customers (label)' = VAR v = [Active Customers] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))
		lineageTag: 1a02fdf8-c896-58a8-8579-8d7803e03e4c

	measure 'Repeat Purchase Rate (label)' = VAR v = [Repeat Purchase Rate] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.00%"))
		lineageTag: 1b4eca8f-c081-5872-b8d7-893f91d4322a

	measure 'Customers (Snapshot) (label)' = VAR v = [Customers (Snapshot)] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))
		lineageTag: ee549b13-423a-5b3d-8d4d-be9a81df883e

	measure 'Average Recency (days) (label)' = VAR v = [Average Recency (days)] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))
		lineageTag: ad6393ec-cb8e-5382-b960-8b4dbbb0638f

	measure 'Historical CLV (label)' = VAR v = [Historical CLV] RETURN IF(ISBLANK(v), "–", SWITCH(TRUE(), v >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.0") & " miliar", v >= 1e7, "Rp " & FORMAT(v / 1e6, "#,0.0") & " juta", "Rp " & FORMAT(v, "#,0")))
		lineageTag: bb99cf1d-962b-5602-81f0-d77fcefe2413

	measure 'Predicted CLV 12m (label)' = VAR v = [Predicted CLV 12m] RETURN IF(ISBLANK(v), "–", SWITCH(TRUE(), v >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.0") & " miliar", v >= 1e7, "Rp " & FORMAT(v / 1e6, "#,0.0") & " juta", "Rp " & FORMAT(v, "#,0")))
		lineageTag: 3a47afb9-409d-57f1-8d38-84f03be29bae

	measure 'Churn Rate (Inactivity) (label)' = VAR v = [Churn Rate (Inactivity)] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.0%"))
		lineageTag: eba1f183-3129-535c-af4f-d80966ebbf59

	measure 'Average Purchase Interval (label)' = VAR v = [Average Purchase Interval] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0") & " hari")
		lineageTag: c12a638d-c8ce-5e7b-9bfc-76cbfeec16e0

	measure 'High-Value At-Risk Customers (label)' = VAR v = [High-Value At-Risk Customers] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))
		lineageTag: 0fe32491-f30c-5408-9108-966689b13598

	measure 'High-Value At-Risk Revenue (label)' = VAR v = [High-Value At-Risk Revenue] RETURN IF(ISBLANK(v), "–", SWITCH(TRUE(), v >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.0") & " miliar", v >= 1e7, "Rp " & FORMAT(v / 1e6, "#,0.0") & " juta", "Rp " & FORMAT(v, "#,0")))
		lineageTag: ec207d2e-4908-5e70-b92c-4a5ba47ff0ef

	measure 'High-Potential Customers (label)' = VAR v = [High-Potential Customers] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))
		lineageTag: 047d99ce-d7bc-5c27-92db-e8cc09370200

	measure 'High-Potential CLV (label)' = VAR v = [High-Potential CLV] RETURN IF(ISBLANK(v), "–", SWITCH(TRUE(), v >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.0") & " miliar", v >= 1e7, "Rp " & FORMAT(v / 1e6, "#,0.0") & " juta", "Rp " & FORMAT(v, "#,0")))
