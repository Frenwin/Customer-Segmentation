table fact_orders
	lineageTag: 61a3ef94-a5c9-50a5-9444-585458f2fb95

	measure Orders = COUNTROWS('fact_orders')
		formatString: #,0
		lineageTag: 56db109e-219a-5100-b7b2-462e7904a19a

	measure 'New Customers' = CALCULATE(DISTINCTCOUNT('fact_orders'[customer_key]), 'fact_orders'[is_first_order] = 1)
		formatString: #,0
		lineageTag: 3a06b857-b8ae-54c7-8f4b-b53f73b0ccc2

	measure 'Returning Customers' = CALCULATE(DISTINCTCOUNT('fact_orders'[customer_key]), 'fact_orders'[is_first_order] = 0)
		formatString: #,0
		lineageTag: 924b1c76-a4e4-5aaa-9942-20daa45cf961

	measure 'Average Review Score' = AVERAGE('fact_orders'[review_score])
		formatString: 0.00
		lineageTag: 83c4cf64-bc56-56dd-9872-9700d0dcd254

	measure 'Late Delivery Share' = AVERAGE('fact_orders'[is_late])
		formatString: 0.0%
		lineageTag: f8b0fcfa-a587-5b09-a502-50ac752a07d4

	measure 'Average Delivery Days' = AVERAGE('fact_orders'[delivery_days])
		formatString: 0.0
		lineageTag: 6f116594-9f64-5935-8a77-94b5be820f02

	measure 'Average Installments' = AVERAGE('fact_orders'[installments])
		formatString: 0.00
		lineageTag: 060056e8-e078-5b6c-85a0-df09d4d133b0

	measure 'New Customers (label)' = VAR v = [New Customers] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))
		lineageTag: f4c6bb72-57d5-56e8-8dfd-296bb54a3edd

	measure 'Average Installments (label)' = VAR v = [Average Installments] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.00"))
		lineageTag: 943e0348-5989-5ba0-8a2b-61ea88ca9671

	measure 'Average Review Score (label)' = VAR v = [Average Review Score] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.00"))
		lineageTag: f29c5c68-a6ab-5982-b29a-ae1f805aa075

