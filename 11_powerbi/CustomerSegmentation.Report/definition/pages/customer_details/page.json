{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "customer_details",
  "displayName": "Customer Details (drill-through)",
  "displayOption": "FitToPage",
  "height": 800,
  "width": 1280,
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F2F4F8'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ],
    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F2F4F8'"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "filterConfig": {
    "filters": [
      {
        "name": "dt_filter",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "dim_customer"
              }
            },
            "Property": "segment_name"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      }
    ]
  },
  "pageBinding": {
    "name": "customer_details_binding",
    "type": "Drillthrough",
    "parameters": [
      {
        "name": "customer_details_param",
        "boundFilter": "dt_filter",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "dim_customer"
              }
            },
            "Property": "segment_name"
          }
        }
      }
    ]
  },
  "type": "Drillthrough"
}