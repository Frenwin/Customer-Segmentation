// DAX measures of the CustomerSegmentation semantic model (generated by build_pbip.py)

// table: fact_sales   format: "Rp" #,0
[Total Revenue] =
    SUM('fact_sales'[line_total])

// table: fact_sales   format: #,0
[Total Orders] =
    DISTINCTCOUNT('fact_sales'[order_key])

// table: fact_sales   format: #,0
[Total Customers] =
    DISTINCTCOUNT('fact_sales'[customer_key])

// table: fact_sales   format: #,0
[Items Sold] =
    SUM('fact_sales'[quantity])

// table: fact_sales   format: "Rp" #,0
[Average Order Value] =
    DIVIDE([Total Revenue], [Total Orders])

// table: fact_sales   format: "Rp" #,0
[Average Revenue per Customer] =
    DIVIDE([Total Revenue], [Total Customers])

// table: fact_sales   format: 0.000
[Purchase Frequency] =
    DIVIDE([Total Orders], [Total Customers])

// table: fact_sales   format: 0.00
[Average Basket Size] =
    DIVIDE([Items Sold], [Total Orders])

// table: fact_sales   format: 0.0%
[Revenue Contribution] =
    DIVIDE([Total Revenue], CALCULATE([Total Revenue], REMOVEFILTERS('dim_customer'[segment_name], 'dim_customer'[segment_id])))

// table: fact_sales   format: 0.0%
[Segment Distribution] =
    DIVIDE([Total Customers], CALCULATE([Total Customers], REMOVEFILTERS('dim_customer'[segment_name], 'dim_customer'[segment_id])))

// table: fact_sales
[Revenue Label] =
    VAR v = [Total Revenue] RETURN SWITCH(TRUE(), ISBLANK(v), "–", v >= 1e12, "Rp " & FORMAT(v / 1e12, "#,0.00") & " triliun", v >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.0") & " miliar", v >= 1e7, "Rp " & FORMAT(v / 1e6, "#,0.0") & " juta", "Rp " & FORMAT(v, "#,0"))

// table: fact_sales   format: #,0.0
[Revenue (Rp miliar)] =
    DIVIDE([Total Revenue], 1e9)

// table: fact_sales   format: 0
[AOV (Rp ribu)] =
    DIVIDE([Average Order Value], 1e3)

// table: fact_sales   format: 0
[Avg Spend (Rp ribu)] =
    DIVIDE([Average Revenue per Customer], 1e3)

// table: fact_sales   format: "Rp" #,0
[Top 10 Revenue] =
    VAR r = RANKX(ALLSELECTED('dim_customer'[customer_code]), [Total Revenue], , DESC) RETURN IF(r <= 10, [Total Revenue])

// table: fact_orders   format: #,0
[Orders] =
    COUNTROWS('fact_orders')

// table: fact_orders   format: #,0
[New Customers] =
    CALCULATE(DISTINCTCOUNT('fact_orders'[customer_key]), 'fact_orders'[is_first_order] = 1)

// table: fact_orders   format: #,0
[Returning Customers] =
    CALCULATE(DISTINCTCOUNT('fact_orders'[customer_key]), 'fact_orders'[is_first_order] = 0)

// table: fact_orders   format: 0.00
[Average Review Score] =
    AVERAGE('fact_orders'[review_score])

// table: fact_orders   format: 0.0%
[Late Delivery Share] =
    AVERAGE('fact_orders'[is_late])

// table: fact_orders   format: 0.0
[Average Delivery Days] =
    AVERAGE('fact_orders'[delivery_days])

// table: fact_orders   format: 0.00
[Average Installments] =
    AVERAGE('fact_orders'[installments])

// table: dim_customer   format: #,0
[Customers (Snapshot)] =
    COUNTROWS('dim_customer')

// table: dim_customer   format: #,0
[Active Customers] =
    CALCULATE(COUNTROWS('dim_customer'), 'dim_customer'[is_churned] = 0)

// table: dim_customer   format: #,0
[Churned Customers] =
    CALCULATE(COUNTROWS('dim_customer'), 'dim_customer'[is_churned] = 1)

// table: dim_customer   format: 0.0%
[Churn Rate (Inactivity)] =
    DIVIDE(COALESCE([Churned Customers], 0), [Customers (Snapshot)])

// table: dim_customer   format: 0.0%
[Active Customer Rate] =
    DIVIDE([Active Customers], [Customers (Snapshot)])

// table: dim_customer   format: 0.00%
[Repeat Purchase Rate] =
    DIVIDE(SUM('dim_customer'[is_repeat]), [Customers (Snapshot)])

// table: dim_customer   format: "Rp" #,0
[Historical CLV] =
    AVERAGE('dim_customer'[historical_clv])

// table: dim_customer   format: "Rp" #,0
[Predicted CLV 12m] =
    AVERAGE('dim_customer'[predicted_clv_12m])

// table: dim_customer   format: 0
[Historical CLV (Rp ribu)] =
    DIVIDE([Historical CLV], 1e3)

// table: dim_customer   format: #,0
[Average Recency (days)] =
    AVERAGE('dim_customer'[recency_days])

// table: dim_customer   format: #,0 "days"
[Average Purchase Interval] =
    AVERAGE('dim_customer'[avg_purchase_interval_days])

// table: dim_customer
[Segment Color] =
    SELECTEDVALUE('dim_customer'[segment_color], "#C5CAD6")

// table: dim_customer   format: "Rp" #,0
[High-Value At-Risk Revenue] =
    CALCULATE(SUM('dim_customer'[monetary]), 'dim_customer'[is_high_value_at_risk] = 1)

// table: dim_customer   format: #,0
[High-Value At-Risk Customers] =
    CALCULATE(COUNTROWS('dim_customer'), 'dim_customer'[is_high_value_at_risk] = 1)

// table: dim_customer   format: "Rp" #,0
[High-Potential CLV] =
    CALCULATE(SUM('dim_customer'[predicted_clv_12m]), 'dim_customer'[is_high_potential] = 1)

// table: dim_customer   format: #,0
[High-Potential Customers] =
    CALCULATE(COUNTROWS('dim_customer'), 'dim_customer'[is_high_potential] = 1)

// table: period_retention   format: 0.00%
[Retention Rate] =
    DIVIDE(SUM('period_retention'[retained_customers]), SUM('period_retention'[eligible_customers]))

// table: period_retention   format: 0.00%
[Churn Rate] =
    1 - [Retention Rate]

// table: period_retention   format: 0.00%
[Reactivation Rate] =
    DIVIDE(SUM('period_retention'[reactivated_customers]), SUM('period_retention'[inactive_customers]))

// table: period_retention   format: #,0
[Reactivated Customers] =
    SUM('period_retention'[reactivated_customers])

// table: cohort_retention   format: 0.00%
[Cohort Retention] =
    DIVIDE(SUM('cohort_retention'[active_customers]), SUM('cohort_retention'[cohort_size]))

// table: cohort_retention
[Cohort Cell Color] =
    VAR v = [Cohort Retention] RETURN SWITCH(TRUE(), ISBLANK(v), "#ffffff", v >= 0.006, "#26408F", v >= 0.004, "#4D6BC6", v >= 0.0025, "#8DA2E0", v >= 0.0012, "#C7D2F0", v > 0, "#EEF1FA", "#ffffff")

// table: cohort_retention
[Cohort Text Color] =
    IF([Cohort Retention] >= 0.004, "#ffffff", "#1B2233")

// table: segment_profile
[Profile Color] =
    SELECTEDVALUE('segment_profile'[color], "#C5CAD6")

// table: segment_profile
[Growth Color] =
    VAR g = SELECTEDVALUE('segment_profile'[segment_growth_rate]) RETURN IF(g < 0, "#C8423B", "#3A5BA0")

// table: revenue_pareto   format: 0.0%
[Top 10% Revenue Share] =
    CALCULATE(MAX('revenue_pareto'[cum_revenue_share]), 'revenue_pareto'[customer_pct] = 0.10)

// table: revenue_pareto   format: 0.0%
[Top 20% Revenue Share] =
    CALCULATE(MAX('revenue_pareto'[cum_revenue_share]), 'revenue_pareto'[customer_pct] = 0.20)

// table: meta
[Data As Of] =
    "Data as of " & FORMAT(MAX('meta'[analysis_date]), "dd mmm yyyy") & "  ·  refreshed " & FORMAT(MAX('meta'[refreshed_at]), "dd mmm yyyy hh:nn")

// table: meta
[Campaign Note] =
    "Campaign performance: not available — the Olist dataset contains no campaign history. Measure each strategy with an A/B test against a hold-out group."

// table: fact_sales
[Total Customers (label)] =
    VAR v = [Total Customers] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))

// table: dim_customer
[Active Customers (label)] =
    VAR v = [Active Customers] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))

// table: fact_orders
[New Customers (label)] =
    VAR v = [New Customers] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))

// table: fact_sales
[Average Order Value (label)] =
    VAR v = [Average Order Value] RETURN IF(ISBLANK(v), "–", SWITCH(TRUE(), v >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.0") & " miliar", v >= 1e7, "Rp " & FORMAT(v / 1e6, "#,0.0") & " juta", "Rp " & FORMAT(v, "#,0")))

// table: dim_customer
[Repeat Purchase Rate (label)] =
    VAR v = [Repeat Purchase Rate] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.00%"))

// table: dim_customer
[Customers (Snapshot) (label)] =
    VAR v = [Customers (Snapshot)] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))

// table: fact_sales
[Segment Distribution (label)] =
    VAR v = [Segment Distribution] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.0%"))

// table: fact_sales
[Revenue Contribution (label)] =
    VAR v = [Revenue Contribution] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.0%"))

// table: fact_sales
[Average Revenue per Customer (label)] =
    VAR v = [Average Revenue per Customer] RETURN IF(ISBLANK(v), "–", SWITCH(TRUE(), v >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.0") & " miliar", v >= 1e7, "Rp " & FORMAT(v / 1e6, "#,0.0") & " juta", "Rp " & FORMAT(v, "#,0")))

// table: fact_sales
[Purchase Frequency (label)] =
    VAR v = [Purchase Frequency] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.000"))

// table: dim_customer
[Average Recency (days) (label)] =
    VAR v = [Average Recency (days)] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))

// table: dim_customer
[Historical CLV (label)] =
    VAR v = [Historical CLV] RETURN IF(ISBLANK(v), "–", SWITCH(TRUE(), v >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.0") & " miliar", v >= 1e7, "Rp " & FORMAT(v / 1e6, "#,0.0") & " juta", "Rp " & FORMAT(v, "#,0")))

// table: dim_customer
[Predicted CLV 12m (label)] =
    VAR v = [Predicted CLV 12m] RETURN IF(ISBLANK(v), "–", SWITCH(TRUE(), v >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.0") & " miliar", v >= 1e7, "Rp " & FORMAT(v / 1e6, "#,0.0") & " juta", "Rp " & FORMAT(v, "#,0")))

// table: revenue_pareto
[Top 10% Revenue Share (label)] =
    VAR v = [Top 10% Revenue Share] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.0%"))

// table: revenue_pareto
[Top 20% Revenue Share (label)] =
    VAR v = [Top 20% Revenue Share] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.0%"))

// table: period_retention
[Retention Rate (label)] =
    VAR v = [Retention Rate] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.00%"))

// table: period_retention
[Churn Rate (label)] =
    VAR v = [Churn Rate] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.00%"))

// table: period_retention
[Reactivated Customers (label)] =
    VAR v = [Reactivated Customers] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))

// table: dim_customer
[Churn Rate (Inactivity) (label)] =
    VAR v = [Churn Rate (Inactivity)] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.0%"))

// table: dim_customer
[Average Purchase Interval (label)] =
    VAR v = [Average Purchase Interval] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0") & " hari")

// table: fact_sales
[Average Basket Size (label)] =
    VAR v = [Average Basket Size] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.00"))

// table: fact_orders
[Average Installments (label)] =
    VAR v = [Average Installments] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.00"))

// table: fact_orders
[Average Review Score (label)] =
    VAR v = [Average Review Score] RETURN IF(ISBLANK(v), "–", FORMAT(v, "0.00"))

// table: dim_customer
[High-Value At-Risk Customers (label)] =
    VAR v = [High-Value At-Risk Customers] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))

// table: dim_customer
[High-Value At-Risk Revenue (label)] =
    VAR v = [High-Value At-Risk Revenue] RETURN IF(ISBLANK(v), "–", SWITCH(TRUE(), v >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.0") & " miliar", v >= 1e7, "Rp " & FORMAT(v / 1e6, "#,0.0") & " juta", "Rp " & FORMAT(v, "#,0")))

// table: dim_customer
[High-Potential Customers (label)] =
    VAR v = [High-Potential Customers] RETURN IF(ISBLANK(v), "–", FORMAT(v, "#,0"))

// table: dim_customer
[High-Potential CLV (label)] =
    VAR v = [High-Potential CLV] RETURN IF(ISBLANK(v), "–", SWITCH(TRUE(), v >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.0") & " miliar", v >= 1e7, "Rp " & FORMAT(v / 1e6, "#,0.0") & " juta", "Rp " & FORMAT(v, "#,0")))
